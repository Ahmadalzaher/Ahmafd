# ---------------------------------------------------------------
# Arab Kulturfestival — performance, encoding and security
# Maintained manually. The WordPress block below is generated by WP.
# ---------------------------------------------------------------

# Use UTF-8 for text responses
AddDefaultCharset UTF-8

<IfModule mod_mime.c>
	AddCharset UTF-8 .atom .css .js .json .rss .vtt .xml
	AddType image/avif avif
	AddType image/avif-sequence avifs
</IfModule>

# Do not expose the server / plugin stack
<IfModule mod_headers.c>
	Header unset ETag
	Header unset X-Powered-By
	Header always unset X-Powered-By
	Header set X-Content-Type-Options "nosniff"
	Header set Referrer-Policy "strict-origin-when-cross-origin"
	Header set X-Frame-Options "SAMEORIGIN"
</IfModule>
FileETag None

# CORS for images (only when the request actually has an Origin header)
<IfModule mod_setenvif.c>
	<IfModule mod_headers.c>
		<FilesMatch "\.(avifs?|cur|gif|png|jpe?g|svgz?|ico|webp)$">
			SetEnvIf Origin ":" IS_CORS
			Header set Access-Control-Allow-Origin "*" env=IS_CORS
		</FilesMatch>
	</IfModule>
</IfModule>

# Allow web fonts to be requested from any origin
<FilesMatch "\.(eot|otf|tt[cf]|woff2?)$">
	<IfModule mod_headers.c>
		Header set Access-Control-Allow-Origin "*"
	</IfModule>
</FilesMatch>

# Static assets only: cache publicly.
# Dynamic HTML (cart, checkout, login) must keep WordPress' private/no-store
# headers, so it is deliberately NOT included here.
<IfModule mod_alias.c>
	<FilesMatch "\.(css|htc|js|asf|asx|wax|wmv|wmx|avi|bmp|class|divx|doc|docx|eot|exe|gif|gz|gzip|ico|jpg|jpeg|jpe|json|mdb|mid|midi|mov|qt|mp3|m4a|mp4|m4v|mpeg|mpg|mpe|mpp|otf|odb|odc|odf|odg|odp|ods|odt|ogg|pdf|pot|pps|ppt|pptx|ra|ram|svg|svgz|swf|tar|tif|tiff|ttf|ttc|wav|wma|wri|xla|xls|xlsx|xlt|xlw|zip)$">
		<IfModule mod_headers.c>
			Header unset Pragma
			Header append Cache-Control "public"
		</IfModule>
	</FilesMatch>
</IfModule>

# Browser cache lifetimes
<IfModule mod_expires.c>
	ExpiresActive on
	ExpiresDefault "access plus 1 month"
	ExpiresByType text/cache-manifest "access plus 0 seconds"
	ExpiresByType text/html "access plus 0 seconds"
	ExpiresByType text/xml "access plus 0 seconds"
	ExpiresByType application/xml "access plus 0 seconds"
	ExpiresByType application/json "access plus 0 seconds"
	ExpiresByType application/rss+xml "access plus 1 hour"
	ExpiresByType image/x-icon "access plus 1 week"
	ExpiresByType image/gif "access plus 4 months"
	ExpiresByType image/png "access plus 4 months"
	ExpiresByType image/jpeg "access plus 4 months"
	ExpiresByType image/webp "access plus 4 months"
	ExpiresByType video/ogg "access plus 4 months"
	ExpiresByType audio/ogg "access plus 4 months"
	ExpiresByType video/mp4 "access plus 4 months"
	ExpiresByType video/webm "access plus 4 months"
	ExpiresByType image/avif "access plus 4 months"
	ExpiresByType image/avif-sequence "access plus 4 months"
	ExpiresByType text/x-component "access plus 1 month"
	ExpiresByType font/ttf "access plus 4 months"
	ExpiresByType font/otf "access plus 4 months"
	ExpiresByType font/woff "access plus 4 months"
	ExpiresByType font/woff2 "access plus 4 months"
	ExpiresByType image/svg+xml "access plus 1 month"
	ExpiresByType application/vnd.ms-fontobject "access plus 1 month"
	ExpiresByType text/css "access plus 1 year"
	ExpiresByType application/javascript "access plus 1 year"
</IfModule>

# Compression
<IfModule mod_deflate.c>
	SetOutputFilter DEFLATE
	<IfModule mod_setenvif.c>
		<IfModule mod_headers.c>
			SetEnvIfNoCase ^(Accept-EncodXng|X-cept-Encoding|X{15}|~{15}|-{15})$ ^((gzip|deflate)\s*,?\s*)+|[X~-]{4,13}$ HAVE_Accept-Encoding
			RequestHeader append Accept-Encoding "gzip,deflate" env=HAVE_Accept-Encoding
			SetEnvIfNoCase Request_URI \.(?:gif|jpe?g|png|rar|zip|exe|flv|mov|wma|mp3|avi|swf|mp?g|mp4|webm|webp|pdf)$ no-gzip dont-vary
		</IfModule>
	</IfModule>
	<IfModule mod_filter.c>
		AddOutputFilterByType DEFLATE application/atom+xml application/javascript application/json application/rss+xml application/vnd.ms-fontobject application/x-font-ttf application/xhtml+xml application/xml font/opentype image/svg+xml image/x-icon text/css text/html text/plain text/x-component text/xml
	</IfModule>
	<IfModule mod_headers.c>
		Header append Vary Accept-Encoding
	</IfModule>
</IfModule>

# BEGIN WordPress
# The directives (lines) between "BEGIN WordPress" and "END WordPress" are
# dynamically generated, and should only be modified via WordPress filters.
# Any changes to the directives between these markers will be overwritten.
<IfModule mod_rewrite.c>
	RewriteEngine On
	RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
	RewriteBase /
	RewriteRule ^index\.php$ - [L]
	RewriteCond %{REQUEST_FILENAME} !-f
	RewriteCond %{REQUEST_FILENAME} !-d
	RewriteRule . /index.php [L]
</IfModule>

# END WordPress

# ---------------------------------------------------------------
# Security
# ---------------------------------------------------------------

# Disable directory browsing
Options -Indexes

# Protect configuration files (Apache 2.4 first, legacy fallback)
<Files "wp-config.php">
	<IfModule mod_authz_core.c>
		Require all denied
	</IfModule>
	<IfModule !mod_authz_core.c>
		Order Allow,Deny
		Deny from all
	</IfModule>
</Files>

<Files ".htaccess">
	<IfModule mod_authz_core.c>
		Require all denied
	</IfModule>
	<IfModule !mod_authz_core.c>
		Order Allow,Deny
		Deny from all
	</IfModule>
</Files>

# XML-RPC is not used by this site (no Jetpack installed).
<Files "xmlrpc.php">
	<IfModule mod_authz_core.c>
		Require all denied
	</IfModule>
	<IfModule !mod_authz_core.c>
		Order Allow,Deny
		Deny from all
	</IfModule>
</Files>

# Protect logs, backups and editor swap files
<FilesMatch "\.(log|sh|bak|inc|swp|dist)$">
	<IfModule mod_authz_core.c>
		Require all denied
	</IfModule>
	<IfModule !mod_authz_core.c>
		Order Allow,Deny
		Deny from all
	</IfModule>
</FilesMatch>

# ---------------------------------------------------------------
# WebP: serve the pre-generated .webp variant when the client supports it
# ---------------------------------------------------------------
<IfModule mod_rewrite.c>
	RewriteEngine On
	RewriteCond %{HTTP_ACCEPT} image/webp
	RewriteCond %{REQUEST_FILENAME}.webp -f
	RewriteRule ^(.+)\.(jpe?g|png)$ $1.$2.webp [T=image/webp,E=request_image:1,L]
</IfModule>

<IfModule mod_headers.c>
	Header append Vary Accept env=request_image
	Header append Vary Accept env=REDIRECT_request_image
</IfModule>

